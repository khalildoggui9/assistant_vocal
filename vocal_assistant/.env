# ── Assistant ──────────────────────────────
ASSISTANT_NAME=Aria
ASSISTANT_WAKE_WORD=aria

# ── Groq AI — mets ta clé ici ──────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Vosk STT ───────────────────────────────
VOSK_MODEL_PATH=model

# ── pyttsx3 TTS ────────────────────────────
TTS_RATE=160
TTS_VOLUME=1.0

# ── Django ─────────────────────────────────
SECRET_KEY=change-this-in-production
DEBUG=True

MIC_DEVICE_INDEX=1
MIC_CHANNELS=2
